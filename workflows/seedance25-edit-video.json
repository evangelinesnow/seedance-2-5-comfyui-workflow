      "resolution": "720p",
      "aspect_ratio": "16:9",
      "generate_audio": true,
      "take": 0,
      "edit_video": [
        "1",
        0
      ]
    }
  },
  "3": {
    "class_type": "Seedance25Result",
    "_meta": {
      "title": "Seedance 2.5 Result"
    },
    "inputs": {
      "request_id": [
        "2",
        0
      ],
      "max_wait_minutes": 60
    }
  }
