      "aspect_ratio": "9:16",
      "generate_audio": true,
      "take": 0,
      "refs": [
        "3",
        0
      ]
    }
  },
  "5": {
    "class_type": "Seedance25Result",
    "_meta": {
      "title": "Seedance 2.5 Result"
    },
    "inputs": {
      "request_id": [
        "4",
        0
      ],
      "max_wait_minutes": 60
